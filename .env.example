# .env example (place in project root directory)
# multiple keys separated by commas
YOUTUBE_API_KEYS=key1,key2,key3
# your OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Pipeline flags
FULL_AUDIO_ANALYSIS=true
PERSIST_AGENT_SUMMARIES=true
DRY_RUN=false

# Video filtering options
# Video duration: any, short (<4 minutes), medium (4-20 minutes), long (>20 minutes)
VIDEO_DURATION="any"
# Video definition: any, high, standard
VIDEO_DEFINITION="any"
# Video type: any, episode, movie
VIDEO_TYPE="any"

# Search & analysis
# RANKING OPTIONS: view_count, rating, relevance, date, title
FILTER_TYPE="view_count"
# Search keyword
KEYWORD=""
# Number of related keywords to generate (keyword generation)
MAX_N=3
# Top K search results to consider
TOP_K=2

# Storage & concurrency
CONCURRENCY=2
# Database filename, it's recommended to use a different name for each run to avoid overwriting
DB_PATH="run1.db"
