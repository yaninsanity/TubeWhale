# TubeWhale Enterprise Platform Environment Configuration
# 环境变量配置文件

# ============== DJANGO CONFIGURATION ==============
SECRET_KEY=tubewhale-enterprise-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============== DATABASE CONFIGURATION ==============
# SQLite (默认开发环境)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=tubewhale.db

# PostgreSQL (生产环境)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tubewhale_db
# DB_USER=tubewhale_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ============== REDIS CONFIGURATION ==============
REDIS_URL=redis://localhost:6379/1

# ============== CELERY CONFIGURATION ==============
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============== AI & API CONFIGURATION ==============
# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============== EMAIL CONFIGURATION ==============
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============== LOGGING ==============
DJANGO_LOG_LEVEL=INFO

# ============== SECURITY ==============
# 生产环境安全配置
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============== FILE STORAGE ==============
# AWS S3 (可选)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=tubewhale-media
# AWS_S3_REGION_NAME=us-east-1
# USE_S3=False
