# .env 示例（放在项目根目录
# 多个 key 用逗号隔开
YOUTUBE_API_KEYS=key1,key2,key3
# 向 weilu 获取统一 key
OPENAI_API_KEY=your_openai_api_key

# Pipeline flags
FULL_AUDIO_ANALYSIS=true
PERSIST_AGENT_SUMMARIES=true
DRY_RUN=false

# Search & analysis
FILTER_TYPE="view_count"
# 搜索关键词
KEYWORD=""
# 联想词汇数量（keyword generation）
MAX_N=3
# top 几（搜索结果）
TOP_K=3

# Storage & concurrency
CONCURRENCY=2
# 数据库文件名，建议每次试验换个名字以避免覆盖
DB_PATH="run1.db"
