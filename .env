# .env 示例（放在项目根目录
# 多个 key 用逗号隔开
YOUTUBE_API_KEYS=key1,key2,key3
# 向 weilu 获取统一 key
OPENAI_API_KEY=your_openai_api_key

# Pipeline flags
FULL_AUDIO_ANALYSIS=true
PERSIST_AGENT_SUMMARIES=true
DRY_RUN=false

# Video filtering options
# 视频时长: any (任意), short (<4分钟), medium (4-20分钟), long (>20分钟)
VIDEO_DURATION="any"
# 视频清晰度: any (任意), high (高清), standard (标清)
VIDEO_DEFINITION="any"
# 视频类型: any (任意), episode (剧集), movie (电影)
VIDEO_TYPE="any"

# Search & analysis
# 排序方式: view_count (观看次数), rating (评分), relevance (相关性), date (发布日期), title (标题)
FILTER_TYPE="view_count"
# 搜索关键词
KEYWORD=""
# 联想词汇数量（keyword generation）
MAX_N=3
# top 几（搜索结果）
TOP_K=2

# Storage & concurrency
CONCURRENCY=2
# 数据库文件名，建议每次试验换个名字以避免覆盖
DB_PATH="run1.db"
