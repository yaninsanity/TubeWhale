# ============================================================================
# TubeWhale Production Docker Environment Configuration
# 工业级部署环境变量配置
# ============================================================================

# Django Core Configuration
DEBUG=False
SECRET_KEY=tubewhale-docker-production-secret-key-CHANGE-THIS-IN-PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,tubewhale.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration - PostgreSQL for Docker
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tubewhale
DB_USER=tubewhale
DB_PASSWORD=tubewhale123
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://tubewhale:tubewhale123@postgres:5432/tubewhale

# Redis Configuration - Docker internal network
REDIS_URL=redis://:redis123@redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=1

# Celery Configuration
CELERY_BROKER_URL=redis://:redis123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/0
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True
CELERY_WORKER_HIJACK_ROOT_LOGGER=False
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True

# Static/Media files
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Django Environment 
DJANGO_SETTINGS_MODULE=tubewhale_project.settings
PYTHONPATH=/app

# ============================================================================
# API Keys Configuration - 生产环境中必须替换为真实密钥
# ============================================================================

# YouTube Data API v3 - 获取视频信息
# 从 https://console.developers.google.com/ 获取
YOUTUBE_API_KEY=your-youtube-api-key-here

# OpenAI API - GPT模型调用
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your-openai-api-key-here

# 可选的其他API密钥
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============================================================================
# 安全配置 - Production Security Settings
# ============================================================================

# Session配置
SESSION_ENGINE=django.contrib.sessions.backends.cache
SESSION_CACHE_ALIAS=default
SESSION_COOKIE_SECURE=False  # 生产环境中设置为True（需要HTTPS）
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=86400  # 24小时

# CSRF保护
CSRF_COOKIE_SECURE=False  # 生产环境中设置为True（需要HTTPS）
CSRF_COOKIE_HTTPONLY=True

# ============================================================================
# 日志配置
# ============================================================================

LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# ============================================================================
# 应用特定配置
# ============================================================================

# TubeWhale分析配置
DEFAULT_ANALYSIS_TIMEOUT=300  # 5分钟
MAX_VIDEO_DURATION=3600  # 1小时
DEFAULT_EXPERT_ROLE=content_creator
DEFAULT_TEMPLATE=basic_performance

# 限流配置
RATE_LIMIT_ENABLED=True
ANALYSIS_RATE_LIMIT=10/hour  # 每小时10次分析

# 文件上传配置
MAX_UPLOAD_SIZE=100485760  # 100MB
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,wmv,flv,webm

# ============================================================================
# 监控和健康检查
# ============================================================================

# Sentry错误监控（可选）
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# 健康检查配置
HEALTH_CHECK_ACCESS_TOKEN=tubewhale-health-check-token

# ============================================================================
# 缓存配置
# ============================================================================

CACHE_TTL=3600  # 1小时
ANALYSIS_CACHE_TTL=86400  # 24小时
TEMPLATE_CACHE_TTL=3600  # 1小时