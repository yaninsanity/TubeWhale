## Python / Django basics
*.pyc
__pycache__/
.coverage*
.pytest_cache/
.env
*.db  # ignore new local SQLite DBs (won't affect already-tracked ones)
*.sqlite
*.sqlite3

## Django static build outputs (keep static/ source tracked)
/staticfiles/
/static_collected/

## IDE & system
.DS_Store
.idea/
*.swp
*.swo
.vscode/

## Virtual environments
venv/
env/
*venv*/
venv_tubewhale/

## Project runtime artifacts
/downloads/
/logs/
/media/uploads/
/exports/
/outputs/
/*.ndjson
/*.csv
/*.jsonl

## Development temp files
temp_*
*.tmp
*.bak
*.orig

## Translation build artifacts (keep .po tracked)
*.mo
/locale/*/LC_MESSAGES/*.mo
/messages.mo

## DO NOT ignore tests or general source files
# Removed over-broad patterns (e.g., test_*.py, *_test.py, static/, tests/) that hid real source.
# Keep your repository clean by deleting junk instead of masking with .gitignore.

## Container/local overrides
# Keep Dockerfiles/config in git; optionally ignore your local override
docker-compose.override.yml

## Do not blanket-ignore source directories like docs/, tests/, static/, .github/

## Logs and misc local files
*.log
*.pid
server.log
cookies.txt
init_db.sql
profile.prof
*.coverage
.mypy_cache/
.ruff_cache/
__pypackages__/
celerybeat-schedule
task_monitor.html
test_progress_monitor.html

# Large media (if transient) – comment out if you deliberately track
*.mp3
*.webm
*.wav
*.m4a
*.part

## (Legacy) If these exist locally, consider deleting instead of ignoring
# flask_requirements.txt
# admin_panel.py
